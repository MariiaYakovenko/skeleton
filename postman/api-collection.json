						"exec": [
							"try {",
							"  const json = pm.response.json();",
							"  const token = json?.session?.access_token;",
							"  if (token) {",
							"      pm.collectionVariables.set('access_token', json?.session?.access_token)",
							"  }",
							"} catch (e) {}",
							""
